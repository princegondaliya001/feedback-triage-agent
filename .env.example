# ---- LLM ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Gmail ----
# Path to OAuth desktop credentials downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Gmail label that marks feedback emails (create it in Gmail, apply to test emails)
GMAIL_LABEL=feedback
GMAIL_MAX_RESULTS=20

# ---- GitHub ----
GITHUB_TOKEN=ghp_...
# owner/repo where issues are created
GITHUB_REPO=your-username/feedback-triage-demo

# ---- Slack ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---- Agent behaviour ----
# critical items require human approval in the terminal before an issue is created
REQUIRE_APPROVAL_FOR=critical
# 0-100 fuzzy title similarity to treat as duplicate
DEDUP_THRESHOLD=80
TRACE_DIR=logs
